{
  "name": "meshport-v57",
  "private": true,
  "version": "57.0.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "typecheck:server": "tsc -p server --noEmit",
    "contract:compile": "hardhat compile",
    "contract:deploy": "hardhat run contracts/deploy-hardhat.cjs --network arcTestnet",
    "contract:deploy:p2p-escrow": "hardhat run contracts/deploy-p2p-escrow.cjs --network arcTestnet",
    "treasury:fund": "node contracts/fund-treasury.cjs",
    "treasury:balance": "node contracts/check-treasury.cjs",
    "install:win": "npm install --ignore-scripts"
  },
  "dependencies": {
    "@noble/curves": "^1.4.2",
    "@circle-fin/adapter-ethers-v6": "^1.0.0",
    "@circle-fin/adapter-viem-v2": "^1.0.0",
    "@circle-fin/app-kit": "^1.0.0",
    "@supabase/supabase-js": "^2.50.0",
    "@tanstack/react-query": "^5.17.19",
    "buffer": "^6.0.3",
    "clsx": "^2.1.0",
    "date-fns": "^3.3.1",
    "dotenv": "^17.4.2",
    "ethers": "^6.13.0",
    "framer-motion": "^11.0.3",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.323.0",
    "qrcode": "^1.5.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.0",
    "tailwind-merge": "^2.2.1",
    "viem": "^2.30.0",
    "web-push": "^3.6.7",
    "ws": "^8.18.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vercel/node": "^5.0.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "eslint": "^8.56.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.2.2",
    "vite": "^5.1.0",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vite-plugin-pwa": "^0.19.2",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": "24.x"
  }
}
