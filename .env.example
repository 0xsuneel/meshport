# Copy this file to `.env` and fill in the values. `.env` is never committed.
# Local dev proxies /api/* to https://meshport.xyz, so only browser (VITE_*) values are needed.
VITE_SUPABASE_URL=https://cvvpzfvzweszuuxvaayb.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_REWARDS_CONTRACT=
VITE_P2P_ESCROW_CONTRACT=
VITE_ADMIN_PANEL_PATH=
VITE_P2P_RECONCILE_AFTER=
# Gasless Bring Funds (MeshPortBridgeRouter — deploy with `npm run contract:deploy:bridge-router`).
# JSON of router addresses per source chain; empty = off (Bring Funds keeps its current flow).
VITE_BRIDGE_ROUTERS=

# Wallet frame (src/wallet, wallet-frame/) - the separate origin that holds wallet keys.
# App: where the frame is served. Must be a subdomain of the app's site
# (same-site, so its storage is first-party). Dev default: http://localhost:5174
VITE_WALLET_ORIGIN=https://wallet.meshport.xyz
# Frame: the app origins allowed to talk to it (comma list, exact origins).
# Keep in sync with frame-ancestors in wallet-frame/vercel.json. Dev default: http://localhost:5173
VITE_WALLET_PARENT_ORIGINS=https://meshport.xyz,https://www.meshport.xyz
